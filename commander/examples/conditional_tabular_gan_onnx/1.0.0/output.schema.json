{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Conditional Tabular GAN ONNX Output",
  "type": "object",
  "required": ["generated_features"],
  "properties": {
    "generated_features": {
      "type": "array",
      "items": {
        "type": "array",
        "minItems": 5,
        "maxItems": 5,
        "items": {"type": "number", "minimum": 0.0, "maximum": 1.00001}
      }
    }
  },
  "additionalProperties": false
}
