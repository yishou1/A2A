{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Intent Gaussian Naive Bayes ONNX Input",
  "type": "object",
  "required": ["features"],
  "properties": {
    "features": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "type": "array",
        "minItems": 5,
        "maxItems": 5,
        "items": {"type": "number", "minimum": 0.0, "maximum": 1.0}
      },
      "description": "Rows ordered as radar_activity, communication_intensity, movement_consistency, weapon_signature, proximity_score."
    }
  },
  "additionalProperties": false
}
