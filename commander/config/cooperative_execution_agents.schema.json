{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cooperative_execution_agents.schema.json",
  "title": "Cooperative execution Agent deployment",
  "type": "object",
  "additionalProperties": false,
  "required": ["agents"],
  "properties": {
    "agents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["agent_id", "port", "resource_types", "capabilities"],
        "properties": {
          "agent_id": {"type": "string", "minLength": 1},
          "host": {"type": "string", "minLength": 1},
          "port": {"type": "integer", "minimum": 1, "maximum": 65535},
          "resource_types": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "capabilities": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "allowed_event_sources": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "max_concurrent_tasks": {"type": "integer", "minimum": 1},
          "state_db": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
