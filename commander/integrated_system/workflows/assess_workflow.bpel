<process name="AssessWorkflow" targetNamespace="http://a2a.project613/workflow">
  <variables>
    <variable name="MissionInput" type="JsonObject"/>
    <variable name="EffectEvaluationResult" type="JsonObject"/>
  </variables>
  <sequence>
    <invoke name="EffectEvaluation" partnerLink="ClosedLoopAgent" operation="evaluateMissionEffect" requiredSkill="closed_loop_optimization" inputVariable="MissionInput" outputVariable="EffectEvaluationResult" />
  </sequence>
</process>
