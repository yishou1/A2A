# 战术情报 Agent（复制为 .env 后按需修改）
PYTHONPATH=.

# 推理配置：config/default.yaml（真实）或 config/mock.yaml（轻量）
TIA_CONFIG=config/default.yaml

# 服务端口（8015 可能与 evaluator 冲突，联调建议 8016）
TIA_PORT=8016
TIA_NACOS_REGISTER=0

# Nacos（remote 模式联调时设为 1）
# TIA_NACOS_REGISTER=1
# NACOS_ADDR=127.0.0.1:8848

# SynapseRAG（default.yaml 中 llm_model 使用 OpenAI 时需要）
# OPENAI_API_KEY=sk-...
# Commander/Agent algorithm library runtime.
NACOS_ADDR=127.0.0.1:8848
ENABLE_LLM=true
ALGORITHM_LIBRARY_ENABLED=true
ALGORITHM_LIBRARY_REQUIRED=true
A2A_ALGORITHM_BACKEND=algolib
ALGOLIB_BASE_URL=http://127.0.0.1:8088
ALGOLIB_TIMEOUT_SECONDS=15
ALGOLIB_FALLBACK_LOCAL=true

# Tactical intelligence Agent.
TIA_USE_MOCK=0
TIA_EXECUTION_MODE=algorithm_library
TIA_ALGORITHM_PLANNER=llm
TIA_ALGOLIB_CALL_MODE=run

# Task scheduling Agent.
TASK_SCHEDULING_BACKEND=algolib
TASK_SCHEDULING_USE_ALGOLIB=true
TASK_SCHEDULING_ALGORITHM_PLANNER=llm

# Decision/compliance/execution Agents.
DECISION_AGENT_BACKEND=algolib
CLOSED_LOOP_BACKEND=algolib
EXECUTION_CONTROL_BACKEND=algolib

# OpenAI-compatible tool LLM settings.
LLM_PROVIDER=azure_openai
TOOL_LLM_URL=
TOOL_LLM_NAME=gpt-4o-mini
API_KEY=
OPENAI_API_BASE=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=30
LLM_MAX_TOKENS=2048
LLM_JSON_MODE=false
LLM_JSON_RETRY_COUNT=1
LLM_STRIP_THINKING=true
