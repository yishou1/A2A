NACOS_ENABLED=false
NACOS_SERVER=127.0.0.1:8848
NACOS_NAMESPACE=public
NACOS_GROUP=DEFAULT_GROUP

# Use A2A-Agent when integrating with the shared A2A repository.
SERVICE_NAME=A2A-Agent
SERVICE_IP=127.0.0.1
SERVICE_PORT=8102
AGENT_ID=track-threat-group-agent-01
AGENT_ROLE=track_threat
AGENT_STATUS=idle
HEARTBEAT_INTERVAL=5

# The preferred path is: GPT-4o-mini plans allowed skills, then the Agent
# validates and invokes the shared algorithm library. Local physics/model
# implementations are a degraded fallback, not the primary integration path.
ALGORITHM_PROVIDER=llm_algolib_hybrid_runtime
ALGORITHM_LIBRARY_ENABLED=false
ALGORITHM_LIBRARY_REQUIRED=false
ALGOLIB_BASE_URL=http://127.0.0.1:8088
ALGOLIB_TIMEOUT_SECONDS=10

# Set ENABLE_LLM=true only after supplying the deployment-specific credentials.
ENABLE_LLM=false
TOOL_LLM_REQUIRED=false
LLM_PROVIDER=azure_openai
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-12-01-preview
AZURE_OPENAI_API_KEY=
LLM_TIMEOUT_SECONDS=30

# Optional local restart snapshot. Defaults to:
# ../.a2a_state/track_threat_agent_state.json when running from this repo.
TRACK_THREAT_STATE_PATH=

# Optional trained ST-GNN v2 TorchScript bundles. The Agent will use the
# built-in models/track_threat bundles when these values are empty. Install
# requirements-model.txt on a host that enables TorchScript CPU inference.
ST_GNN_AIRCRAFT_MODEL_DIR=
ST_GNN_SHIP_MODEL_DIR=
# Backward-compatible single-model entry (treated as aircraft):
ST_GNN_MODEL_DIR=
ST_GNN_REQUIRED=false
# Set true in customer/acceptance deployments to reject candidate bundles whose
# model_manifest.json release_gate.passed is not true.
ST_GNN_ENFORCE_RELEASE_GATE=false
ST_GNN_MAX_INFERENCE_MS=200
# start_track_threat_agent.sh installs/loads TorchScript CPU runtime by default.
# Set false only for a deliberately degraded Kalman/IMM/NumPy-only deployment.
TRACK_THREAT_ENABLE_TORCHSCRIPT=true
