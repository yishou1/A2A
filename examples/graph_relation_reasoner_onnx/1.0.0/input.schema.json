{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Graph Relation Reasoner ONNX Input",
  "type": "object",
  "required": ["node_features", "edge_features", "node_mask"],
  "properties": {
    "node_features": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "array",
        "minItems": 10,
        "maxItems": 10,
        "items": {
          "type": "array",
          "minItems": 7,
          "maxItems": 7,
          "items": {"type": "number"}
        }
      }
    },
    "edge_features": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "array",
        "minItems": 10,
        "maxItems": 10,
        "items": {
          "type": "array",
          "minItems": 10,
          "maxItems": 10,
          "items": {
            "type": "array",
            "minItems": 6,
            "maxItems": 6,
            "items": {"type": "number"}
          }
        }
      }
    },
    "node_mask": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "array",
        "minItems": 10,
        "maxItems": 10,
        "items": {"type": "number", "minimum": 0.0, "maximum": 1.0}
      }
    }
  },
  "additionalProperties": false
}
