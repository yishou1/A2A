{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Multimodal Mamba Fusion ONNX Input",
  "type": "object",
  "required": ["sequence", "mask"],
  "properties": {
    "sequence": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "array",
        "minItems": 4,
        "maxItems": 4,
        "items": {
          "type": "array",
          "minItems": 256,
          "maxItems": 256,
          "items": {"type": "number"}
        }
      },
      "description": "Batch rows with modality order eo_ir, sar, radar, text_report. Missing modalities are zero-filled."
    },
    "mask": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "array",
        "minItems": 4,
        "maxItems": 4,
        "items": {"type": "number", "minimum": 0.0, "maximum": 1.0}
      },
      "description": "Validity mask aligned to sequence modalities."
    }
  },
  "additionalProperties": false
}
