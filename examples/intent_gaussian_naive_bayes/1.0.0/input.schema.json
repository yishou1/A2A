{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Intent Gaussian Naive Bayes Input",
  "type": "object",
  "required": ["observations"],
  "properties": {
    "observations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "type": "object",
        "required": [
          "observation_id",
          "radar_activity",
          "communication_intensity",
          "movement_consistency",
          "weapon_signature",
          "proximity_score"
        ],
        "properties": {
          "observation_id": {"type": "string", "minLength": 1},
          "radar_activity": {"type": "number", "minimum": 0, "maximum": 1},
          "communication_intensity": {"type": "number", "minimum": 0, "maximum": 1},
          "movement_consistency": {"type": "number", "minimum": 0, "maximum": 1},
          "weapon_signature": {"type": "number", "minimum": 0, "maximum": 1},
          "proximity_score": {"type": "number", "minimum": 0, "maximum": 1}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
