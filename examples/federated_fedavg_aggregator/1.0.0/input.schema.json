{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Federated FedAvg Aggregator Input",
  "type": "object",
  "required": ["round_id", "client_updates"],
  "properties": {
    "round_id": {"type": "string", "minLength": 1},
    "client_updates": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "required": ["client_id", "sample_count", "weights"],
        "properties": {
          "client_id": {"type": "string", "minLength": 1},
          "sample_count": {"type": "integer", "minimum": 1},
          "weights": {"type": "object"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
