{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Conditional Tabular GAN Input",
  "type": "object",
  "required": ["condition", "sample_count"],
  "properties": {
    "condition": {
      "type": "string",
      "enum": ["benign", "surveillance", "hostile"]
    },
    "sample_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000
    }
  },
  "additionalProperties": false
}
