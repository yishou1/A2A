{
  "title": "MOTR Neural Kalman Tracker Output",
  "type": "object",
  "required": ["tracks"],
  "properties": {
    "tracks": {
      "type": "array",
      "description": "关联后的轨迹列表",
      "items": {
        "type": "object",
        "required": ["track_id", "bbox"],
        "properties": {
          "track_id": { "type": "string" },
          "class_name": { "type": "string" },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "state": {
            "type": "string",
            "description": "active|lost|…（实现相关）"
          },
          "bbox": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "items": { "type": "number" }
          },
          "last_bbox": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "items": { "type": "number" }
          },
          "position_px": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": { "type": "number" }
          },
          "geo": { "type": "object" },
          "kalman_gain": { "type": "number" }
        },
        "additionalProperties": true
      }
    },
    "associations": {
      "type": "integer",
      "minimum": 0,
      "description": "本帧成功关联/新建轨迹数（实现相关）"
    }
  },
  "additionalProperties": true
}
