# Copy to A2A/.runtime/synapserag/service.env and edit model endpoints if needed.
# This file is sourced by Bash. Do not commit real API keys.
SYNAPSERAG_PYTHON=python3
SYNAPSERAG_SAVE_DIR=${ROOT_DIR}/algorithmrepo/knowledge_bases/newport_roe_handbook_2022
SYNAPSERAG_RECORDS_DIR=${SYNAPSERAG_SAVE_DIR}/records
SYNAPSERAG_INDEX_ID=newport-roe-handbook-2022-v1
SYNAPSERAG_HOST=127.0.0.1
SYNAPSERAG_PORT=8000
SYNAPSERAG_API_TOKEN=
SYNAPSERAG_TRACE_RETENTION_DAYS=0
SYNAPSERAG_EMBEDDING_MODEL=qwen3-embedding:0.6b
SYNAPSERAG_EMBEDDING_BASE_URL=http://127.0.0.1:11434/v1
SYNAPSERAG_QA_MODEL=qwen3:1.7b
SYNAPSERAG_QA_BASE_URL=http://127.0.0.1:11434/v1
