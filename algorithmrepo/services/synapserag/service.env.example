# Copy to A2A/.runtime/synapserag/service.env and edit for this machine.
# This file is sourced by Bash. Do not commit real API keys.
SYNAPSERAG_PYTHON=/absolute/path/to/external/venv/bin/python
SYNAPSERAG_SAVE_DIR=/absolute/path/to/external/synapserag-data
SYNAPSERAG_INDEX_ID=api-server-kb-v1
SYNAPSERAG_HOST=127.0.0.1
SYNAPSERAG_PORT=8000
SYNAPSERAG_API_TOKEN=
SYNAPSERAG_TRACE_RETENTION_DAYS=365
SYNAPSERAG_EMBEDDING_MODEL=qwen3-embedding:0.6b
SYNAPSERAG_EMBEDDING_BASE_URL=http://127.0.0.1:11434/v1
SYNAPSERAG_QA_MODEL=qwen3:1.7b
SYNAPSERAG_QA_BASE_URL=http://127.0.0.1:11434/v1
