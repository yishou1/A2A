{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Multimodal Mamba Fusion ONNX Output",
  "type": "object",
  "required": ["fused_embeddings"],
  "properties": {
    "fused_embeddings": {
      "type": "array",
      "items": {
        "type": "array",
        "minItems": 256,
        "maxItems": 256,
        "items": {"type": "number", "minimum": -1.0, "maximum": 1.0}
      }
    }
  },
  "additionalProperties": false
}
