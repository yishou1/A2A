{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Threat Priority Random Forest Input",
  "type": "object",
  "required": ["targets"],
  "properties": {
    "targets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "type": "object",
        "required": [
          "target_id",
          "threat_score",
          "distance_km",
          "speed_mps",
          "asset_value",
          "intel_confidence"
        ],
        "properties": {
          "target_id": {"type": "string", "minLength": 1},
          "threat_score": {"type": "number", "minimum": 0, "maximum": 1},
          "distance_km": {"type": "number", "minimum": 0, "maximum": 10000},
          "speed_mps": {"type": "number", "minimum": 0, "maximum": 5000},
          "asset_value": {"type": "number", "minimum": 0, "maximum": 1},
          "intel_confidence": {"type": "number", "minimum": 0, "maximum": 1}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
