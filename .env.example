# Azure OpenAI chat deployment used for algorithm selection.
# Recommended for shared development: keep API-hosted LLM by default so a
# local Qwen model is not required. Override at launch with:
#   ./scripts/start.sh --llm-profile azure
#   ./scripts/start.sh --llm-profile local-qwen-gpu
#   ./scripts/start.sh --llm-profile offline
LLM_PROFILE=azure
ENABLE_LLM=true
LLM_PROVIDER=azure_openai
AZURE_OPENAI_ENDPOINT=https://wysengine.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=4o-mini
AZURE_OPENAI_CHAT_DEPLOYMENT=4o-mini
AZURE_OPENAI_API_VERSION=2024-12-01-preview
AZURE_OPENAI_API_KEY=

# Reserved for a future Azure embedding integration. It is not called today.
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
AZURE_OPENAI_EMBEDDING_API_VERSION=2024-02-01

# Shared runtime defaults.
NACOS_ADDR=127.0.0.1:8848
A2A_BACKEND_MODE=gateway
A2A_GATEWAY_URL=http://127.0.0.1:8030
A2A_COMMANDER_URL=http://127.0.0.1:8021
A2A_REQUEST_TIMEOUT=180

# Bounded in-process caches and durable-history retention. Byte values are
# decimal integers and may be reduced further on small-memory demo hosts.
A2A_AGENT_RESPONSE_CACHE_MAX_ITEMS=64
A2A_AGENT_RESPONSE_CACHE_MAX_BYTES=33554432
A2A_AGENT_STREAM_CACHE_MAX_ITEMS=32
A2A_AGENT_STREAM_CACHE_MAX_BYTES=8388608
A2A_AGENT_WORK_LIST_CACHE_MAX_ITEMS=32
A2A_AGENT_WORK_LIST_CACHE_MAX_BYTES=8388608
TRACK_AGENT_TASK_CACHE_COUNT=16
TRACK_AGENT_TASK_CACHE_BYTES=33554432
TRACK_AGENT_STREAM_CACHE_COUNT=16
TRACK_AGENT_STREAM_CACHE_BYTES=8388608
TRACK_AGENT_WORK_LIST_COUNT=16
TRACK_AGENT_WORK_LIST_BYTES=8388608
A2A_AGENT_WORK_LIST_MAX_ITEMS=32
A2A_AGENT_WORK_LIST_MAX_BYTES=8388608
A2A_MANAGER_TERMINAL_HISTORY=32
GATEWAY_TERMINAL_CACHE_MAX_ITEMS=12
GATEWAY_TERMINAL_CACHE_MAX_BYTES=134217728
AMOS_WORKFLOW_RUN_CACHE_MAX_ITEMS=32
AMOS_WORKFLOW_RUN_CACHE_MAX_BYTES=33554432

# Persistent history is pruned after successful writes; the active record is
# always protected even when it is larger than the configured byte budget.
A2A_CHECKPOINT_RETENTION_COUNT=128
A2A_CHECKPOINT_RETENTION_BYTES=1073741824
A2A_IDEMPOTENCY_RETENTION_COUNT=256
A2A_IDEMPOTENCY_RETENTION_BYTES=67108864
A2A_IDEMPOTENCY_RETENTION_DAYS=14
GATEWAY_PACKAGE_RETENTION_COUNT=128
GATEWAY_PACKAGE_RETENTION_BYTES=2147483648
GATEWAY_WORKFLOW_RETENTION_COUNT=128
GATEWAY_WORKFLOW_RETENTION_BYTES=536870912
GATEWAY_IDEMPOTENCY_RETENTION_COUNT=128
AMOS_RUN_RETENTION_COUNT=256
AMOS_RUN_RETENTION_BYTES=268435456
AMOS_RUN_RETENTION_DAYS=30

# Simulation/Commander algorithm runtime.
A2A_ALGORITHM_BACKEND=algolib
ALGOLIB_TRANSPORT=gateway
ALGOLIB_BASE_URL=http://127.0.0.1:8088
ALGOLIB_TIMEOUT_SECONDS=15
ALGOLIB_ENABLE_LLM=true
ALGOLIB_FALLBACK_LOCAL=true
ALGORITHM_LIBRARY_ENABLED=true
A2A_FORCE_ALGOLIB_FIRST=1
CLOSED_LOOP_FEATURE_MODE=strict

# Tactical intelligence Agent.
TIA_USE_MOCK=0
TIA_EXECUTION_MODE=algorithm_library
TIA_ALGORITHM_PLANNER=llm
TIA_ALGOLIB_CALL_MODE=run

# Task scheduling Agent.
TASK_SCHEDULING_BACKEND=algolib
TASK_SCHEDULING_USE_ALGOLIB=true
TASK_SCHEDULING_ALGORITHM_PLANNER=llm

# Decision/compliance/execution Agents. Use algolib when matching algorithm
# services are registered; keep local fallback behavior in code for gaps.
DECISION_AGENT_BACKEND=algolib
CLOSED_LOOP_BACKEND=algolib
EXECUTION_CONTROL_BACKEND=algolib
# Algorithm compute profile: low, medium (default), or high.
CLOSED_LOOP_ALGORITHM_PROFILE=medium
EXECUTION_CONTROL_ALGORITHM_PROFILE=medium

# Shared evidence retrieval used by local workflows and algorithm-library cores.
RAG_BACKEND=local
SYNAPSERAG_BASE_URL=http://127.0.0.1:8000
SYNAPSERAG_TRANSPORT=direct
SYNAPSERAG_API_TOKEN=
SYNAPSERAG_TIMEOUT_SECONDS=60
SYNAPSERAG_TOP_K_PLANNING=3
SYNAPSERAG_TOP_K_COMPLIANCE=3
# Optional override for examples/<algorithm_id>/<version> package discovery.
DECISION_CAPABILITY_PACKAGE_ROOT=

# OpenAI-compatible tool LLM settings used by Commander Agents.
TOOL_LLM_URL=
TOOL_LLM_NAME=gpt-4o-mini
API_KEY=

# Optional local-Qwen settings. These are used only when
# LLM_PROFILE=local-qwen-gpu / --llm-profile local-qwen-gpu is selected.
LOCAL_QWEN_BASE_URL=http://127.0.0.1:11435/v1
LOCAL_QWEN_PORT=11435
LOCAL_QWEN_DEVICE=auto
LOCAL_QWEN_DTYPE=auto
A2A_ACT_AGENT_LLM=true
OPENAI_API_BASE=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=30
LLM_MAX_TOKENS=2048
LLM_JSON_MODE=false
LLM_JSON_RETRY_COUNT=1
LLM_STRIP_THINKING=true
